<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<link rel="stylesheet" href="assets/css/header.css">
<!-- 헤더 섹션 -->
    <header class="top-header">
        <%
            request.getSession();
            String mem_id = (String) session.getAttribute("loginResult");
            Boolean isAdmin = (Boolean) session.getAttribute("isAdmin");
            if (isAdmin == null) {
                isAdmin = false;
            }

            String log = "";
            if (mem_id == null) {
                log = "<a href='auth.jsp'> 로그인 </a>";
            } else {
                log = "<a href='logout.do'> 로그아웃 </a>";
            }

            String mem = "";
            if (mem_id == null) {
                mem = "<a href='auth.jsp?mode=signup'> 회원가입 </a>";
            } else {
                if (isAdmin) {
                    mem = "<a href='adminPage.do'> 관리자 페이지 </a>";
                } else {
                    mem = "<a href='myPage.do'> 마이페이지 </a>";
                }
            }

            String headerSuccessMessage = (String) session.getAttribute("successMessage");
            if (headerSuccessMessage != null && !headerSuccessMessage.isEmpty()) {
                session.removeAttribute("successMessage");
        %>
        <p role="status"><%= com.web.common.Html.escape(headerSuccessMessage) %></p>
        <%
            }
        %>
        <div class="top-nav">
            <ul class="top-nav-right">
                <li><a href="index.jsp">HOME</a></li>
                <li><%= log %></li>
                <li><%= mem %></li>
            </ul>
        </div>
        <div class="top-main-nav">
            <nav>
                <ul class="top-nav-left">
                    <li><a href="index.jsp"><img src="assets/images/logo-black.png" alt="Logo"></a></li>
                    <li><a href="about.jsp" class="underline">소개</a></li>
                    <li><a href="adopt" class="underline">입양</a></li>
                    <li><a href="index.jsp#community" class="underline">참여</a></li>
                    <li><a href="index.jsp#support" class="underline">후원</a></li>
                </ul>
            </nav>
        </div>
    </header>
